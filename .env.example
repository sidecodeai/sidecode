# SideCode gateway configuration.
#
#   cp .env.example .env
#   # set PUBLIC_ORIGIN and RC_PASSWORD
#   docker compose up -d
#
# Everything below has a working default except PUBLIC_ORIGIN and RC_PASSWORD; the gateway refuses
# to start without those two and says which one is missing.

# The exact origin apps use. It is compared against the browser's Origin header on every
# cookie-authenticated write, and it is baked into the pairing command served at /install.sh.
# No trailing slash, no path.
PUBLIC_ORIGIN=https://rc.example.com

# Where compose publishes the gateway on the host; your reverse proxy forwards to this address.
# GATEWAY_BIND=0.0.0.0 is the default because a proxy that runs as a Docker container (Nginx Proxy
# Manager usually does) reaches the host through the Docker bridge, not through loopback. Narrow it
# to 127.0.0.1 only when the proxy runs on the host network, or when a host firewall already keeps
# the port off the internet.
GATEWAY_PORT=8787
GATEWAY_BIND=0.0.0.0

# Login password for the single user "admin". Use a long random value.
RC_PASSWORD=change-me

# Secret that signs session tokens. Leave empty and the gateway generates one once into DATA_DIR.
# Setting it explicitly does not preserve logins across a wiped volume: a token is only accepted
# while its record is in DATA_DIR/auth.sqlite3, so clearing the volume signs everyone out and
# invalidates every enrolled device token as well, whatever RC_SECRET says.
RC_SECRET=

# Where SQLite databases and generated keys live. Backed by the rc-data volume in compose.
DATA_DIR=/data

# Speech to text. One of `none`, `openai`, `mimo`, `realtime`; any other value stops the gateway at
# startup. `none` disables voice input. `openai` targets any server that implements
# POST {STT_BASE_URL}/audio/transcriptions, which includes OpenAI itself and local Whisper servers.
# `mimo` targets Xiaomi MiMo, which recognises audio through a chat completion instead. Those three
# answer a whole utterance, so the words appear about two seconds behind. `realtime` streams: the
# gateway holds a live session over the OpenAI Realtime transcription protocol and the words appear
# as they are said. Whichever it is, the provider always detects the language itself; there is no
# language setting (A44).
# For the bundled `local-stt` compose profile use:
#   STT_PROVIDER=openai
#   STT_BASE_URL=http://stt:8000/v1
#   STT_MODEL=Systran/faster-distil-whisper-small.en
# For MiMo use:
#   STT_PROVIDER=mimo
#   STT_BASE_URL=https://api.xiaomimimo.com/v1
#   STT_MODEL=mimo-v2.5-asr
# For Alibaba Cloud Model Studio (百炼) `qwen3-asr-flash-realtime`, Chinese-first with English mixed
# in, use the workspace id and the API key from the Model Studio console; the Singapore region is
# `ap-southeast-1.maas.aliyuncs.com`, and the model may also be written into the URL as
# `?model=…` (a bare URL gets `?model={STT_MODEL}` appended). STT_BASE_URL is ignored here.
#   STT_PROVIDER=realtime
#   STT_REALTIME_URL=wss://<workspace-id>.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
#   STT_MODEL=qwen3-asr-flash-realtime
#   STT_API_KEY=<Model Studio API key>
STT_PROVIDER=none
STT_BASE_URL=https://api.openai.com/v1
STT_REALTIME_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Dictation polish. When both POLISH_BASE_URL and POLISH_API_KEY are set, the apps offer a switch
# that sends a finished dictation, with the last few messages of the conversation, through this
# model and puts the cleaned-up text back in the composer. This is the only model key the gateway
# ever holds, it is used for nothing else, and nothing from a polish request is stored or sent to a
# device. Leave either value empty and the apps show the switch disabled.
# POLISH_BASE_URL is an OpenAI-compatible root: the gateway calls {POLISH_BASE_URL}/models and
# {POLISH_BASE_URL}/chat/completions. POLISH_MODELS is an optional comma-separated allowlist; it
# both narrows and orders the list the apps show, and it stands in for a provider that serves no
# /models index. POLISH_TIMEOUT_SECONDS bounds one request (default 20).
POLISH_BASE_URL=
POLISH_API_KEY=
POLISH_MODELS=
POLISH_TIMEOUT_SECONDS=20

# EXPERIMENTAL (see docs/LIVE_ASSISTANT.md): a voice assistant that supervises your sessions. Off
# unless both LIVE_ASSISTANT_ENABLED=true and the key are set. The browser talks only to this
# gateway (WS /ws/live); the gateway holds the one WebSocket to the Live API, so the key never
# reaches a browser.
LIVE_ASSISTANT_ENABLED=false
LIVE_OPENAI_API_KEY=
# Required: comma-separated usernames that may use it. Empty means nobody can.
LIVE_ALLOWED_USERS=
LIVE_MODEL=gpt-live-1
# The text model the voice model delegates reasoning and tool calls to.
LIVE_BACKEND_MODEL=gpt-6-luna
# Optional; left out of the session when empty.
LIVE_VOICE=
# A call hangs up after this many seconds without speech, and at most this long in total.
LIVE_IDLE_TIMEOUT_SECONDS=90
LIVE_MAX_CALL_SECONDS=1200
# Call time one account may use per UTC day, counted in memory (a restart starts the day afresh).
LIVE_DAILY_SECONDS=7200
# Gateway-wide cap on simultaneous calls, and the pause an account waits after a call ends.
LIVE_MAX_CONCURRENT_CALLS=2
LIVE_COOLDOWN_SECONDS=10
# Cut the assistant off when the gateway hears you talk over it. Turn off if your speakers' echo
# makes it stop by itself.
LIVE_BARGE_IN=true
# Only for a proxy or a test double: https on any host, or http on a loopback address only.
# LIVE_OPENAI_BASE_URL=https://api.openai.com

# The oldest iOS app this gateway works with, as major.minor.patch. The app compares its own
# version against it and shows a blocking "Update required" screen when it is older, so the two
# never drift apart silently. Leave IOS_MIN_APP_VERSION empty to use the value built into the
# release (rc_gateway/compat.py IOS_MINIMUM_APP_VERSION), which is raised by any release that stops
# working with older iOS builds. Set it only to hold an older fleet back or to push one forward.
# IOS_UPDATE_URL is where that screen's button sends the user: the TestFlight or App Store page for
# the new build. It must be https, and the button is omitted when it is empty. A bad value in
# either variable stops the gateway at startup and says which one.
IOS_MIN_APP_VERSION=
IOS_UPDATE_URL=

# The same pair for the Mac app (A45), whose minimum moves separately: empty uses the release's
# rc_gateway/compat.py MACOS_MINIMUM_APP_VERSION, and the URL is the new Mac build's https page.
MACOS_MIN_APP_VERSION=
MACOS_UPDATE_URL=

# The same pairs for the Android and Windows apps (A46), each moving on its own: empty uses the
# release's rc_gateway/compat.py ANDROID_MINIMUM_APP_VERSION or WINDOWS_MINIMUM_APP_VERSION.
ANDROID_MIN_APP_VERSION=
ANDROID_UPDATE_URL=
WINDOWS_MIN_APP_VERSION=
WINDOWS_UPDATE_URL=

# Apple push notifications for the iOS app. All four APNS_* values are required to enable it;
# leave them empty and the gateway reports apns_enabled: false. APNS_KEY_PATH is the path to the
# .p8 signing key inside the container (mount it read-only, see docker-compose.yml).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
# APNS_TOPIC is the app's bundle id. A self-hosted gateway cannot push to the published apps
# without the publisher's APNs key, so it normally stays empty.
APNS_TOPIC=
APNS_ENVIRONMENT=production

# Web Push contact address (the VAPID "sub" claim). Set it to enable browser notifications; the
# VAPID key pair is generated into DATA_DIR on first start. Leave empty to disable Web Push.
WEB_PUSH_CONTACT=mailto:admin@example.com

# Peers whose X-Forwarded-For header the gateway believes, as a comma-separated list of CIDR
# networks. It must list your reverse proxy's source address as the gateway sees it: the host
# address for a proxy on the host network, and the proxy's Docker network subnet when it runs as a
# container (`docker network inspect <network>` prints it; 172.16.0.0/12 covers the default bridge
# ranges). Loopback only by default. Make sure the proxy replaces rather than appends the header:
# an appending proxy lets a caller pick the first element and therefore its own rate-limit bucket.
TRUSTED_PROXIES=127.0.0.0/8,::1/128

# debug | info | warning | error
LOG_LEVEL=info
