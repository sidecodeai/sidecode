{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remote-control.dev/schema/v1/app_frames.json",
  "title": "remote-control app <-> gateway frames (protocol v1)",
  "description": "Every JSON text frame on WS /ws/app, in both directions. Discriminated by `type`. additionalProperties stays open: unknown fields must be ignored.",
  "$ref": "#/$defs/AppFrame",
  "$defs": {
    "AppFrame": {
      "oneOf": [
        {
          "$ref": "#/$defs/Hello"
        },
        {
          "$ref": "#/$defs/DeviceUpdated"
        },
        {
          "$ref": "#/$defs/DeviceRemoved"
        },
        {
          "$ref": "#/$defs/SessionUpdated"
        },
        {
          "$ref": "#/$defs/SessionRemoved"
        },
        {
          "$ref": "#/$defs/SessionEvent"
        },
        {
          "$ref": "#/$defs/PairingProgress"
        },
        {
          "$ref": "#/$defs/PreferencesUpdated"
        },
        {
          "$ref": "#/$defs/TerminalOutput"
        },
        {
          "$ref": "#/$defs/TerminalExited"
        },
        {
          "$ref": "#/$defs/Ping"
        },
        {
          "$ref": "#/$defs/Pong"
        },
        {
          "$ref": "#/$defs/Reply"
        },
        {
          "$ref": "#/$defs/SessionSubscribe"
        },
        {
          "$ref": "#/$defs/SessionUnsubscribe"
        },
        {
          "$ref": "#/$defs/SessionSeen"
        },
        {
          "$ref": "#/$defs/SessionCreate"
        },
        {
          "$ref": "#/$defs/SessionSend"
        },
        {
          "$ref": "#/$defs/SessionStop"
        },
        {
          "$ref": "#/$defs/SessionApprove"
        },
        {
          "$ref": "#/$defs/SessionAnswer"
        },
        {
          "$ref": "#/$defs/SessionSet"
        },
        {
          "$ref": "#/$defs/SessionHistory"
        },
        {
          "$ref": "#/$defs/SessionBlock"
        },
        {
          "$ref": "#/$defs/SessionCommands"
        },
        {
          "$ref": "#/$defs/SessionCommand"
        },
        {
          "$ref": "#/$defs/SessionQueueRemove"
        },
        {
          "$ref": "#/$defs/SessionResumeSet"
        },
        {
          "$ref": "#/$defs/SessionResumeCancel"
        },
        {
          "$ref": "#/$defs/SessionTakeover"
        },
        {
          "$ref": "#/$defs/SessionArchive"
        },
        {
          "$ref": "#/$defs/SessionDelete"
        },
        {
          "$ref": "#/$defs/DeviceDirs"
        },
        {
          "$ref": "#/$defs/DeviceGit"
        },
        {
          "$ref": "#/$defs/DeviceMkdir"
        },
        {
          "$ref": "#/$defs/TerminalOpen"
        },
        {
          "$ref": "#/$defs/TerminalInput"
        },
        {
          "$ref": "#/$defs/TerminalResize"
        },
        {
          "$ref": "#/$defs/TerminalAttach"
        },
        {
          "$ref": "#/$defs/TerminalClose"
        },
        {
          "$ref": "#/$defs/DeviceAgents"
        },
        {
          "$ref": "#/$defs/DeviceUpdate"
        }
      ]
    },
    "ForwardableRequest": {
      "description": "The app requests the gateway forwards to the owning device unchanged, except that it adds device_id when the request is addressed by session_id and stamps `from`.",
      "oneOf": [
        {
          "$ref": "#/$defs/SessionCreate"
        },
        {
          "$ref": "#/$defs/SessionSend"
        },
        {
          "$ref": "#/$defs/SessionStop"
        },
        {
          "$ref": "#/$defs/SessionApprove"
        },
        {
          "$ref": "#/$defs/SessionAnswer"
        },
        {
          "$ref": "#/$defs/SessionSet"
        },
        {
          "$ref": "#/$defs/SessionHistory"
        },
        {
          "$ref": "#/$defs/SessionBlock"
        },
        {
          "$ref": "#/$defs/SessionCommands"
        },
        {
          "$ref": "#/$defs/SessionCommand"
        },
        {
          "$ref": "#/$defs/SessionQueueRemove"
        },
        {
          "$ref": "#/$defs/SessionResumeSet"
        },
        {
          "$ref": "#/$defs/SessionResumeCancel"
        },
        {
          "$ref": "#/$defs/SessionTakeover"
        },
        {
          "$ref": "#/$defs/SessionArchive"
        },
        {
          "$ref": "#/$defs/SessionDelete"
        },
        {
          "$ref": "#/$defs/DeviceDirs"
        },
        {
          "$ref": "#/$defs/DeviceGit"
        },
        {
          "$ref": "#/$defs/DeviceMkdir"
        },
        {
          "$ref": "#/$defs/TerminalOpen"
        },
        {
          "$ref": "#/$defs/TerminalInput"
        },
        {
          "$ref": "#/$defs/TerminalResize"
        },
        {
          "$ref": "#/$defs/TerminalAttach"
        },
        {
          "$ref": "#/$defs/TerminalClose"
        },
        {
          "$ref": "#/$defs/TerminalDetach"
        },
        {
          "$ref": "#/$defs/DeviceAgents"
        },
        {
          "$ref": "#/$defs/DeviceUpdate"
        }
      ]
    },
    "RequestBase": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "description": "Set by the requester and echoed in the reply.",
          "$ref": "objects.json#/$defs/Uuid"
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "Hello": {
      "description": "Gateway -> app, first frame after connect.",
      "type": "object",
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocol": {
          "const": 1
        },
        "gateway_version": {
          "type": "string"
        },
        "user": {
          "$ref": "objects.json#/$defs/User"
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "objects.json#/$defs/Device"
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "objects.json#/$defs/Session"
          }
        },
        "stt": {
          "$ref": "#/$defs/SttInfo"
        },
        "polish": {
          "$ref": "#/$defs/PolishInfo"
        },
        "apps": {
          "$ref": "objects.json#/$defs/AppsInfo"
        },
        "preferences": {
          "description": "The account's preferences; absent on a gateway older than A35.",
          "$ref": "objects.json#/$defs/Preferences"
        },
        "server_time": {
          "$ref": "objects.json#/$defs/Timestamp"
        }
      },
      "required": [
        "type",
        "protocol",
        "gateway_version",
        "user",
        "devices",
        "sessions",
        "stt",
        "server_time"
      ]
    },
    "PolishInfo": {
      "description": "Whether the gateway can polish dictation through an operator-configured model (A29).",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "SttInfo": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "enabled",
        "languages"
      ]
    },
    "DeviceUpdated": {
      "description": "Gateway -> app.",
      "type": "object",
      "properties": {
        "type": {
          "const": "device.updated"
        },
        "device": {
          "$ref": "objects.json#/$defs/Device"
        }
      },
      "required": [
        "type",
        "device"
      ]
    },
    "DeviceRemoved": {
      "description": "Gateway -> app.",
      "type": "object",
      "properties": {
        "type": {
          "const": "device.removed"
        },
        "device_id": {
          "$ref": "objects.json#/$defs/Uuid"
        }
      },
      "required": [
        "type",
        "device_id"
      ]
    },
    "SessionUpdated": {
      "description": "Gateway -> app.",
      "type": "object",
      "properties": {
        "type": {
          "const": "session.updated"
        },
        "session": {
          "$ref": "objects.json#/$defs/Session"
        }
      },
      "required": [
        "type",
        "session"
      ]
    },
    "SessionRemoved": {
      "description": "Gateway -> app. `device_id` is stamped by the gateway (amendment A5).",
      "type": "object",
      "properties": {
        "type": {
          "const": "session.removed"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "device_id": {
          "$ref": "objects.json#/$defs/Uuid"
        }
      },
      "required": [
        "type",
        "session_id",
        "device_id"
      ]
    },
    "SessionEvent": {
      "description": "Gateway -> app, only for sessions this connection subscribed to. The gateway stamps `device_id` (amendment A5); devices never send it. `session_id` stays the primary key.",
      "type": "object",
      "properties": {
        "type": {
          "const": "session.event"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "event": {
          "$ref": "events.json#/$defs/Event"
        },
        "device_id": {
          "description": "Added by the gateway. Informational and for routing only.",
          "$ref": "objects.json#/$defs/Uuid"
        }
      },
      "required": [
        "type",
        "session_id",
        "event"
      ]
    },
    "PairingProgress": {
      "description": "Gateway -> app, while a pairing code is outstanding.",
      "type": "object",
      "properties": {
        "type": {
          "const": "pairing.progress"
        },
        "code": {
          "$ref": "objects.json#/$defs/PairingCode"
        },
        "step": {
          "enum": [
            "waiting",
            "enrolled",
            "online",
            "agents"
          ]
        },
        "device": {
          "$ref": "objects.json#/$defs/Device"
        }
      },
      "required": [
        "type",
        "code",
        "step"
      ]
    },
    "Ping": {
      "description": "Gateway -> app every 25 s.",
      "type": "object",
      "properties": {
        "type": {
          "const": "ping"
        }
      },
      "required": [
        "type"
      ]
    },
    "Pong": {
      "description": "App -> gateway, answer to ping.",
      "type": "object",
      "properties": {
        "type": {
          "const": "pong"
        }
      },
      "required": [
        "type"
      ]
    },
    "ReplyBase": {
      "type": "object",
      "properties": {
        "type": {
          "const": "reply"
        },
        "id": {
          "$ref": "objects.json#/$defs/Uuid"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "ok"
      ]
    },
    "ReplyOk": {
      "allOf": [
        {
          "$ref": "#/$defs/ReplyBase"
        }
      ],
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "result"
      ]
    },
    "ReplyError": {
      "allOf": [
        {
          "$ref": "#/$defs/ReplyBase"
        }
      ],
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "objects.json#/$defs/Error"
        }
      },
      "required": [
        "error"
      ]
    },
    "Reply": {
      "description": "Gateway -> app. `result` is typed per request in the Reply* defs below.",
      "oneOf": [
        {
          "$ref": "#/$defs/ReplyOk"
        },
        {
          "$ref": "#/$defs/ReplyError"
        }
      ]
    },
    "SessionSubscribe": {
      "description": "App -> gateway, handled by the gateway. Subscribing again replaces the cursor.",
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.subscribe"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "since_seq": {
          "$ref": "objects.json#/$defs/Seq"
        }
      },
      "required": [
        "type",
        "id",
        "session_id"
      ]
    },
    "SessionUnsubscribe": {
      "description": "App -> gateway, handled by the gateway. No reply.",
      "type": "object",
      "properties": {
        "type": {
          "const": "session.unsubscribe"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        }
      },
      "required": [
        "type",
        "session_id"
      ]
    },
    "SessionCreate": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.create"
        },
        "device_id": {
          "$ref": "objects.json#/$defs/Uuid"
        },
        "agent": {
          "$ref": "objects.json#/$defs/AgentId"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "permission_mode": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "worktree": {
          "type": "boolean"
        },
        "first_message": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "speed": {
          "type": [
            "string",
            "null"
          ],
          "description": "A speed tier from AgentInfo.speeds, or null for the standard speed (A21)."
        }
      },
      "required": [
        "type",
        "id",
        "device_id",
        "agent",
        "cwd"
      ]
    },
    "SessionSend": {
      "description": "Limits: text <= 64 KiB; at most 8 attachments, each <= 6 MiB decoded. `auto` sends now when idle, otherwise steers (capability steer) or queues. `interrupt` stops the current turn first.",
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.send"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "text": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "objects.json#/$defs/AttachmentUpload"
          },
          "maxItems": 8
        },
        "mode": {
          "enum": [
            "auto",
            "queue",
            "interrupt"
          ]
        },
        "queue_ts": {
          "description": "A43: for a message taken out of the queue to be edited, the ts that queue entry had. When the message is queued the device holds it under that ts, in front of every entry with a later one.",
          "$ref": "objects.json#/$defs/Timestamp"
        }
      },
      "required": [
        "type",
        "id",
        "session_id",
        "text",
        "mode"
      ]
    },
    "SessionStop": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.stop"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        }
      },
      "required": [
        "type",
        "id",
        "session_id"
      ]
    },
    "SessionApprove": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.approve"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "request_id": {
          "$ref": "objects.json#/$defs/Uuid"
        },
        "option_id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "session_id",
        "request_id",
        "option_id"
      ]
    },
    "SessionAnswer": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.answer"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "request_id": {
          "$ref": "objects.json#/$defs/Uuid"
        },
        "answers": {
          "$ref": "events.json#/$defs/Answers"
        }
      },
      "required": [
        "type",
        "id",
        "session_id",
        "request_id",
        "answers"
      ]
    },
    "SessionSet": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.set"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "model": {
          "type": "string"
        },
        "permission_mode": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "speed": {
          "type": [
            "string",
            "null"
          ],
          "description": "A speed tier from AgentInfo.speeds, or null for the standard speed (A21)."
        }
      },
      "required": [
        "type",
        "id",
        "session_id"
      ]
    },
    "SessionHistory": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        },
        {
          "description": "before_seq and after_seq are mutually exclusive.",
          "not": {
            "required": [
              "before_seq",
              "after_seq"
            ]
          }
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.history"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "before_seq": {
          "$ref": "objects.json#/$defs/Seq"
        },
        "after_seq": {
          "description": "Return stored events with seq greater than this, ascending.",
          "$ref": "objects.json#/$defs/Seq"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 200
        }
      },
      "required": [
        "type",
        "id",
        "session_id"
      ],
      "description": "Page a session's stored history. `before_seq` walks backwards from the newest event; `after_seq` walks forwards and is what the gateway uses to backfill its replay buffer after a device link outage (amendment A9). The two cursors are mutually exclusive."
    },
    "SessionBlock": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.block"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "block_id": {
          "$ref": "objects.json#/$defs/Uuid"
        }
      },
      "required": [
        "type",
        "id",
        "session_id",
        "block_id"
      ]
    },
    "SessionCommands": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "description": "Ask what slash commands the session offers right now (A27). Needs capability `commands` on the session's agent.",
      "properties": {
        "type": {
          "const": "session.commands"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        }
      },
      "required": [
        "type",
        "id",
        "session_id"
      ]
    },
    "SessionCommand": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "description": "Run one slash command on an idle session (A27). The device echoes it as a `user_message` under this request's `id` and reports the outcome as events.",
      "properties": {
        "type": {
          "const": "session.command"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_:.-]*$"
        },
        "argument": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id",
        "session_id",
        "name"
      ]
    },
    "SessionQueueRemove": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.queue_remove"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "queued_id": {
          "$ref": "objects.json#/$defs/Uuid"
        }
      },
      "required": [
        "type",
        "id",
        "session_id",
        "queued_id"
      ]
    },
    "SessionTakeover": {
      "description": "Only for control == \"terminal\" sessions; requires capability takeover.",
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.takeover"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        }
      },
      "required": [
        "type",
        "id",
        "session_id"
      ]
    },
    "SessionArchive": {
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.archive"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        },
        "archived": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "session_id",
        "archived"
      ]
    },
    "SessionDelete": {
      "description": "Removes the session from the device registry. Agent transcripts are not deleted.",
      "allOf": [
        {
          "$ref": "#/$defs/RequestBase"
        }
      ],
      "type": "object",
      "properties": {
        "type": {
          "const": "session.delete"
        },
        "session_id": {
          "$ref": "objects.json#/$defs/Id"
        }
      },
      "required": [
        "type",
